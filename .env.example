# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
#
# НЕ КОММИТЬТЕ .env в git — он в .gitignore.

# ─── Обязательно ───
# Получите в кабинете разработчика EXBO: https://exbo.net
STALCRAFT_CLIENT_SECRET=replace_with_your_client_secret

# ─── Опционально (дефолты в config.py) ───
STALCRAFT_CLIENT_ID=694
# STALCRAFT_OAUTH_URL=https://exbo.net/oauth/token
# STALCRAFT_EAPI_BASE=https://eapi.stalcraft.net
STALCRAFT_REGION=RU
STALCRAFT_TIMEZONE=Europe/Moscow

# ─── Публикация почасовых агрегатов сделок в отдельную Git-ветку ───
# Fine-grained token: Contents Read and write только для CKEJET57/CZCraftCalc.
# Не публикуйте токен и не добавляйте его в Git.
GITHUB_TOKEN=
GITHUB_REPOSITORY=CKEJET57/CZCraftCalc
GITHUB_DATA_BRANCH=market-data
GITHUB_BASE_BRANCH=feature/monorepo
