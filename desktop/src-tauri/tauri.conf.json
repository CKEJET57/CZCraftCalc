{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CZCraftCalc",
  "version": "0.1.0",
  "identifier": "com.czcraftcalc.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CZCraftCalc — Desktop Prototype",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
